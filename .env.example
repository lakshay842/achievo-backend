NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/achievo_ai

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-flash-lite-latest,gemini-3-flash-preview
MOCK_AI=true
AI_FALLBACK_TO_MOCK=true
AI_TIMEOUT_MS=60000
AI_MAX_RETRIES=2

FRONTEND_ORIGIN=http://localhost:8081,http://127.0.0.1:8081,https://achievo-frontend.vercel.app
LOG_LEVEL=info

# Local delivery stores notification attempts without calling Expo.
# Set to false in production when device tokens should receive real pushes.
NOTIFICATIONS_DRY_RUN=true
