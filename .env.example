NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/achievo_ai

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_FALLBACK_MODELS=gemini-2.5-flash
MOCK_AI=true
AI_FALLBACK_TO_MOCK=true
AI_TIMEOUT_MS=20000
AI_MAX_RETRIES=1

FRONTEND_ORIGIN=http://localhost:8081,http://127.0.0.1:8081,https://achievo-frontend.vercel.app
LOG_LEVEL=info

# Local delivery stores notification attempts without calling Expo.
# Set to false in production when device tokens should receive real pushes.
NOTIFICATIONS_DRY_RUN=true

# Local SMTP (works on your machine). Render FREE tier BLOCKS SMTP ports 25/465/587.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Required for Render free tier — HTTPS email API (https://resend.com). Prefer this in production.
RESEND_API_KEY=
# Test sender (no domain needed). For real domain: Achievo AI <noreply@yourdomain.com>
RESEND_FROM=Achievo AI <onboarding@resend.dev>

PASSWORD_RESET_URL_BASE=https://achievo-frontend.vercel.app
